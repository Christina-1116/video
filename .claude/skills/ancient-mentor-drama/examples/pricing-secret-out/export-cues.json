{
 "timebase": "output",
 "cues": [
  {
   "start": 0.15,
   "end": 0.61,
   "text": "爸爸"
  },
  {
   "start": 0.69,
   "end": 3.02,
   "text": "这瓶水成本才一块钱"
  },
  {
   "start": 3.35,
   "end": 5.42,
   "text": "居然卖五块"
  },
  {
   "start": 5.75,
   "end": 7.62,
   "text": "也太黑了吧"
  },
  {
   "start": 7.95,
   "end": 9.13,
   "text": "你觉得贵"
  },
  {
   "start": 9.21,
   "end": 11.02,
   "text": "可有人觉得值"
  },
  {
   "start": 11.35,
   "end": 12.52,
   "text": "这里面的门道"
  },
  {
   "start": 12.6,
   "end": 15.02,
   "text": "两千多年前就有人玩明白了"
  },
  {
   "start": 15.35,
   "end": 16.82,
   "text": "谁啊"
  },
  {
   "start": 17.15,
   "end": 17.68,
   "text": "范蠡"
  },
  {
   "start": 17.76,
   "end": 18.29,
   "text": "商圣"
  },
  {
   "start": 18.37,
   "end": 18.9,
   "text": "走"
  },
  {
   "start": 18.98,
   "end": 20.42,
   "text": "去跟他学学"
  },
  {
   "start": 20.75,
   "end": 22.25,
   "text": "看看便宜东西"
  },
  {
   "start": 22.32,
   "end": 23.82,
   "text": "怎么卖出高价"
  },
  {
   "start": 26.75,
   "end": 29.22,
   "text": "你们是"
  },
  {
   "start": 29.55,
   "end": 31.82,
   "text": "范先生"
  },
  {
   "start": 32.15,
   "end": 34.1,
   "text": "一瓶成本一块的水"
  },
  {
   "start": 34.18,
   "end": 35.62,
   "text": "怎么卖到五块"
  },
  {
   "start": 35.95,
   "end": 37.45,
   "text": "我给你一碗水"
  },
  {
   "start": 37.52,
   "end": 39.02,
   "text": "你试着卖卖看"
  },
  {
   "start": 39.35,
   "end": 41.22,
   "text": "这还不简单"
  },
  {
   "start": 44.55,
   "end": 46.95,
   "text": "清水也敢卖五文"
  },
  {
   "start": 47.03,
   "end": 48.02,
   "text": "抢钱啊"
  },
  {
   "start": 48.35,
   "end": 50.62,
   "text": "怎么没人买"
  },
  {
   "start": 50.95,
   "end": 54.22,
   "text": "因为大家心里都有把尺子"
  },
  {
   "start": 54.55,
   "end": 56.11,
   "text": "水值多少钱"
  },
  {
   "start": 56.19,
   "end": 57.42,
   "text": "谁不知道"
  },
  {
   "start": 57.75,
   "end": 59.62,
   "text": "那怎么办"
  },
  {
   "start": 59.95,
   "end": 62.42,
   "text": "把牌子翻过来"
  },
  {
   "start": 64.95,
   "end": 65.66,
   "text": "山泉"
  },
  {
   "start": 65.74,
   "end": 68.42,
   "text": "这水是山里来的"
  },
  {
   "start": 68.75,
   "end": 69.94,
   "text": "你卖的是水"
  },
  {
   "start": 70.02,
   "end": 72.22,
   "text": "大家拿井水的价格比"
  },
  {
   "start": 72.55,
   "end": 73.72,
   "text": "你卖的是山泉"
  },
  {
   "start": 73.8,
   "end": 76.02,
   "text": "大家就没有旧价格可套了"
  },
  {
   "start": 76.35,
   "end": 77.73,
   "text": "原来不是水变了"
  },
  {
   "start": 77.81,
   "end": 80.22,
   "text": "是大家拿来比较的东西变了"
  },
  {
   "start": 80.55,
   "end": 81.62,
   "text": "卖出去了"
  },
  {
   "start": 81.7,
   "end": 83.62,
   "text": "我再写得厉害点"
  },
  {
   "start": 86.15,
   "end": 87.12,
   "text": "天下第一"
  },
  {
   "start": 87.2,
   "end": 88.18,
   "text": "吹这么满"
  },
  {
   "start": 88.26,
   "end": 90.02,
   "text": "八成是井水兑的"
  },
  {
   "start": 90.35,
   "end": 91.07,
   "text": "我夸它"
  },
  {
   "start": 91.15,
   "end": 93.22,
   "text": "怎么反倒没人信了"
  },
  {
   "start": 93.55,
   "end": 95.05,
   "text": "人见十全"
  },
  {
   "start": 95.13,
   "end": 96.62,
   "text": "必疑有诈"
  },
  {
   "start": 96.95,
   "end": 97.66,
   "text": "写上"
  },
  {
   "start": 97.74,
   "end": 98.84,
   "text": "水太凉"
  },
  {
   "start": 98.92,
   "end": 99.63,
   "text": "冰牙"
  },
  {
   "start": 99.71,
   "end": 100.42,
   "text": "慢喝"
  },
  {
   "start": 100.75,
   "end": 103.02,
   "text": "这不是在说它不好吗"
  },
  {
   "start": 103.35,
   "end": 104.06,
   "text": "冰牙"
  },
  {
   "start": 104.14,
   "end": 106.04,
   "text": "那是真山泉"
  },
  {
   "start": 106.12,
   "end": 107.22,
   "text": "来两碗"
  },
  {
   "start": 107.55,
   "end": 109.02,
   "text": "缺点说在明处"
  },
  {
   "start": 109.1,
   "end": 110.82,
   "text": "好处就成了真的"
  },
  {
   "start": 111.15,
   "end": 113.05,
   "text": "原来缺点不是减分"
  },
  {
   "start": 113.12,
   "end": 115.02,
   "text": "是在证明它是真的"
  },
  {
   "start": 115.35,
   "end": 116.11,
   "text": "天凉了"
  },
  {
   "start": 116.19,
   "end": 118.62,
   "text": "不渴的人谁还买水啊"
  },
  {
   "start": 122.15,
   "end": 123.71,
   "text": "他们不缺水"
  },
  {
   "start": 123.79,
   "end": 125.02,
   "text": "缺一句话"
  },
  {
   "start": 125.35,
   "end": 128.42,
   "text": "改个叫法"
  },
  {
   "start": 128.75,
   "end": 130.82,
   "text": "就改两个字"
  },
  {
   "start": 131.15,
   "end": 133.38,
   "text": "喝了壮行水"
  },
  {
   "start": 133.46,
   "end": 135.22,
   "text": "一路平安"
  },
  {
   "start": 135.55,
   "end": 137.36,
   "text": "给我也来一碗"
  },
  {
   "start": 137.44,
   "end": 138.62,
   "text": "十文也要"
  },
  {
   "start": 138.95,
   "end": 139.72,
   "text": "买解渴"
  },
  {
   "start": 139.8,
   "end": 140.84,
   "text": "五文嫌贵"
  },
  {
   "start": 140.93,
   "end": 141.69,
   "text": "买心意"
  },
  {
   "start": 141.77,
   "end": 142.82,
   "text": "十文嫌少"
  },
  {
   "start": 143.15,
   "end": 145.47,
   "text": "原来大家不只为东西付钱"
  },
  {
   "start": 145.55,
   "end": 147.22,
   "text": "还为它的意思付钱"
  },
  {
   "start": 147.55,
   "end": 148.06,
   "text": "去吧"
  },
  {
   "start": 148.14,
   "end": 149.84,
   "text": "你们那个年代"
  },
  {
   "start": 149.92,
   "end": 151.02,
   "text": "也是一样"
  },
  {
   "start": 153.55,
   "end": 155.7,
   "text": "它不叫“饮用水”"
  },
  {
   "start": 155.78,
   "end": 156.82,
   "text": "叫“山泉”"
  },
  {
   "start": 157.15,
   "end": 160.42,
   "text": "背面还说口感会有差异"
  },
  {
   "start": 160.75,
   "end": 163.01,
   "text": "广告也不说解渴"
  },
  {
   "start": 163.09,
   "end": 164.02,
   "text": "说“出发”"
  },
  {
   "start": 164.35,
   "end": 167.02,
   "text": "现在还觉得黑吗"
  },
  {
   "start": 167.35,
   "end": 167.98,
   "text": "不黑"
  },
  {
   "start": 168.06,
   "end": 170.82,
   "text": "是我只看见了成本"
  }
 ]
}