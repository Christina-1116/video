{"meta": {"title": "How does a plane take off?", "topic": "Thrust, lift and speed: how a 78-ton airliner leaves the ground", "audience": "Curious learners, age 12+", "language": "en-US", "style": "collage", "format": "16:9", "palette": {}, "music": {"mood": "warm", "volume": 0.13}, "ttsVoice": "af_heart", "subtitleDefault": "both", "cuePause": 0.6, "endTitle": "Engines make speed. Wings turn speed into lift.", "credit": "by Dong · Paper Explainer · English narration · EN/中文 subtitles", "slug": "how-a-plane-takes-off", "watermark": "by Dong"}, "scenes": [{"id": "hook", "title": "How does a 78-ton plane take off?", "cues": [{"say": "A passenger jet weighs about seventy-eight tons.", "tr": {"zh": "一架客机重约 78 吨。"}, "caption": "A passenger jet weighs about 78 tons.", "audio": "../voice/hook-1.mp3"}, {"say": "So how does all that weight leave the ground?", "tr": {"zh": "这么重的东西，是怎么离开地面的？"}, "audio": "../voice/hook-2.mp3"}], "elements": [{"id": "rw1", "type": "rect", "x": 800, "y": 712, "w": 1800, "h": 70, "fill": "#5d6366", "shadow": 0.4, "until": "thrust", "z": 1, "in": {"fx": "unfold", "at": 0.1, "dur": 0.8}}, {"id": "rw1-dash", "type": "flow", "points": [[1750, 712], [-150, 712]], "smooth": false, "glyph": "dash", "size": 26, "color": "#f4efe6", "spacing": 150, "speed": 0, "alpha": 0.9, "until": "thrust", "z": 2, "in": {"fx": "fade", "at": 0.5}, "keys": [{"at": "thrust:c2", "dur": 5.5, "ease": "in", "speed": 620}]}, {"id": "plane1", "type": "group", "x": 760, "y": 586, "scale": 1.35, "z": 5, "in": {"fx": "drop", "at": "c1+0.2", "dur": 0.9}, "children": [{"type": "curve", "from": [-20, 22], "to": [-20, 50], "color": "ink", "width": 5}, {"type": "circle", "x": -20, "y": 58, "r": 10, "fill": "ink", "shadow": 0}, {"type": "curve", "from": [180, 22], "to": [180, 48], "color": "ink", "width": 4}, {"type": "circle", "x": 180, "y": 56, "r": 9, "fill": "ink", "shadow": 0}, {"type": "poly", "points": [[-245, -10], [-212, -122], [-182, -122], [-160, -26]], "fill": "red"}, {"type": "poly", "smooth": true, "points": [[-262, -6], [-205, -30], [180, -34], [236, -24], [264, -2], [250, 16], [200, 25], [-200, 25], [-252, 10]], "fill": "card"}, {"type": "poly", "points": [[-236, -2], [-296, -18], [-280, -26], [-205, -14]], "fill": "red", "shadow": 0.4}, {"type": "poly", "points": [[208, -22], [234, -18], [243, -7], [214, -9]], "fill": "blue", "shadow": 0}, {"type": "seq", "from": [-170, -9], "to": [160, -9], "pattern": "ooooooooooooooo", "size": 8, "color": "blue"}, {"type": "rect", "x": 0, "y": 8, "w": 420, "h": 5, "fill": "blue", "shadow": 0, "grain": false}, {"type": "poly", "points": [[-30, 6], [70, 6], [-30, 44], [-75, 44]], "fill": "blue"}, {"type": "rect", "x": 85, "y": 52, "w": 100, "h": 36, "rx": 17, "fill": "#9aa1a3"}, {"type": "rect", "x": 133, "y": 52, "w": 6, "h": 30, "fill": "ink", "shadow": 0, "grain": false}], "until": "thrust"}, {"id": "ton", "type": "tag", "text": "78 t", "x": 760, "y": 420, "fill": "accent", "size": 44, "z": 8, "rotate": 0, "in": {"fx": "stamp", "at": "c1+1.2"}, "until": "forces", "out": {"fx": "pop", "at": "forces:start"}}]}, {"id": "forces", "title": "Four forces at work", "cues": [{"say": "Four forces act on the plane.", "tr": {"zh": "飞机受到四种力的作用。"}, "audio": "../voice/forces-1.mp3"}, {"say": "Weight pulls it down. Thrust pushes it forward.", "tr": {"zh": "重力把它往下拉，推力把它往前推。"}, "audio": "../voice/forces-2.mp3"}, {"say": "Drag holds it back. And lift pushes it up.", "tr": {"zh": "阻力把它往后拖，升力把它往上托。"}, "audio": "../voice/forces-3.mp3"}], "elements": [{"id": "fW", "type": "arrow", "from": [760, 600], "to": [760, 742], "color": "red", "width": 9, "z": 7, "in": {"fx": "draw", "at": "c2", "dur": 0.7}}, {"id": "tW", "type": "tag", "text": "Weight", "x": 880, "y": 712, "fill": "red", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c2+0.4"}, "color": "#ffffff"}, {"id": "fT", "type": "arrow", "from": [1135, 590], "to": [1330, 590], "color": "blue", "width": 9, "z": 7, "in": {"fx": "draw", "at": "c2+1.6", "dur": 0.7}}, {"id": "tT", "type": "tag", "text": "Thrust", "x": 1420, "y": 590, "fill": "blue", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c2+2.0"}, "color": "#ffffff"}, {"id": "fD", "type": "arrow", "from": [345, 586], "to": [170, 586], "color": "muted", "width": 9, "z": 7, "in": {"fx": "draw", "at": "c3", "dur": 0.7}}, {"id": "tD", "type": "tag", "text": "Drag", "x": 110, "y": 520, "fill": "card", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c3+0.4"}}, {"id": "fL", "type": "arrow", "from": [760, 520], "to": [760, 300], "color": "accent", "width": 9, "z": 7, "in": {"fx": "draw", "at": "c3+1.4", "dur": 0.7}}, {"id": "tL", "type": "tag", "text": "Lift", "x": 870, "y": 310, "fill": "accent", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c3+1.8"}}]}, {"id": "thrust", "title": "Thrust: throw air backwards", "cues": [{"say": "The engines suck in air and blast it out the back.", "tr": {"zh": "发动机吸入空气，再从尾部高速喷出。"}, "audio": "../voice/thrust-1.mp3"}, {"say": "Push air backwards, and the plane is pushed forwards.", "tr": {"zh": "把空气往后推，飞机就被往前推。"}, "audio": "../voice/thrust-2.mp3"}, {"say": "It speeds up, faster and faster, down the runway.", "tr": {"zh": "它在跑道上越跑越快。"}, "audio": "../voice/thrust-3.mp3"}], "elements": [{"id": "intake", "type": "flow", "points": [[1150, 656], [960, 656]], "smooth": false, "glyph": "dot", "size": 9, "color": "blue", "spacing": 40, "speed": 160, "z": 6, "in": {"fx": "grow", "at": "c1+0.3"}}, {"id": "exhaust", "type": "flow", "points": [[820, 656], [250, 640]], "smooth": false, "lanes": [-8, 0, 8], "glyph": "dash", "size": 12, "color": "muted", "alpha": 0.75, "spacing": 70, "speed": 520, "z": 6, "in": {"fx": "grow", "at": "c1+0.8"}}, {"id": "tExh", "type": "tag", "text": "Air out → back", "x": 250, "y": 560, "fill": "card", "size": 24, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c1+1.4"}, "out": {"fx": "fade", "at": "c3"}}, {"id": "fT2", "type": "arrow", "from": [1135, 590], "to": [1360, 590], "color": "blue", "width": 11, "z": 7, "in": {"fx": "draw", "at": "c2+0.6", "dur": 0.7}}, {"id": "tT2", "type": "tag", "text": "Plane → forward", "x": 1330, "y": 515, "fill": "blue", "size": 24, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c2+1.0"}, "color": "#ffffff"}, {"id": "spd", "type": "counter", "x": 1370, "y": 190, "fill": "card", "font": "mono", "size": 30, "format": "{v} km/h", "value": 0, "z": 9, "in": {"fx": "drop", "at": "c2+0.4"}, "keys": [{"at": "c2+0.6", "dur": 5.6, "ease": "in", "value": 180}]}]}, {"id": "wing", "title": "The secret is in the wing", "cues": [{"say": "Now cut the wing open, and look at its shape.", "tr": {"zh": "把机翼切开，看看它的截面。"}, "audio": "../voice/wing-1.mp3"}, {"say": "It's curved on top, and tilted slightly upward.", "tr": {"zh": "它上表面弯曲，而且略微向上倾斜。"}, "audio": "../voice/wing-2.mp3"}], "elements": [{"id": "foil", "type": "poly", "smooth": true, "points": [[430, 488], [470, 440], [560, 398], [700, 372], [850, 368], [1000, 386], [1130, 425], [1210, 470], [1130, 482], [1000, 496], [850, 505], [700, 507], [560, 503], [470, 498]], "fill": "blue", "rotate": -5, "origin": [820, 440], "until": "lift", "z": 5, "in": {"fx": "draw", "at": "c1+0.4", "dur": 1.4}}, {"id": "chord", "type": "curve", "from": [380, 495], "to": [1280, 495], "color": "ink", "width": 2.5, "dashed": "10 10", "z": 4, "in": {"fx": "draw", "at": "c2+0.6"}}, {"id": "aoa", "type": "angle", "vertex": [430, 494], "from": 0, "to": 9, "r": 120, "fill": "accent", "label": "", "z": 3, "in": {"fx": "grow", "at": "c2+1.0"}}, {"id": "tAoa", "type": "tag", "text": "tilted ≈ 5°", "x": 330, "y": 400, "fill": "accent", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c2+1.4"}}, {"id": "tCurve", "type": "tag", "text": "curved top", "x": 850, "y": 290, "fill": "card", "size": 26, "z": 8, "rotate": 0, "in": {"fx": "pop", "at": "c2+0.2"}}]}, {"id": "lift", "title": "Bending the air makes lift", "cues": [{"say": "Air flowing over the curved top speeds up, and its pressure drops.", "tr": {"zh": "流过弯曲上表面的空气加速，压强随之降低。"}, "audio": "../voice/lift-1.mp3"}, {"say": "The wing also pushes the air below it downward.", "tr": {"zh": "机翼还把下方的空气往下推。"}, "audio": "../voice/lift-2.mp3"}, {"say": "Lower pressure above, air pushed down below. Together, they push the wing up.", "tr": {"zh": "上方压强低、下方空气被下压，两者一起把机翼往上托。"}, "audio": "../voice/lift-3.mp3"}, {"say": "That upward push is lift.", "tr": {"zh": "这个向上的力，就是升力。"}, "audio": "../voice/lift-4.mp3"}], "elements": [{"id": "fa1", "type": "flow", "points": [[120, 400], [430, 405], [650, 330], [900, 320], [1180, 370], [1500, 410]], "glyph": "arrow", "size": 13, "color": "accent2", "spacing": 90, "speed": 300, "z": 6, "in": {"fx": "grow", "at": "c1+0.2"}}, {"id": "fa2", "type": "flow", "points": [[120, 320], [450, 322], [700, 265], [950, 262], [1230, 300], [1500, 330]], "glyph": "arrow", "size": 13, "color": "accent2", "spacing": 90, "speed": 300, "z": 6, "in": {"fx": "grow", "at": "c1+0.5"}}, {"id": "fb1", "type": "flow", "points": [[120, 560], [450, 562], [800, 590], [1150, 620], [1500, 690]], "glyph": "arrow", "size": 13, "color": "red", "spacing": 90, "speed": 170, "z": 6, "in": {"fx": "grow", "at": "c2+0.2"}}, {"id": "fb2", "type": "flow", "points": [[120, 640], [450, 642], [800, 665], [1150, 700], [1500, 770]], "glyph": "arrow", "size": 13, "color": "red", "spacing": 90, "speed": 170, "z": 6, "in": {"fx": "grow", "at": "c2+0.5"}}, {"id": "lLow", "type": "label", "x": 1270, "y": 215, "anchor": [960, 330], "text": "Faster air", "sub": "lower pressure on top", "bar": "accent2", "z": 9, "in": {"fx": "fade", "at": "c1+1.2"}}, {"id": "lHigh", "type": "label", "x": 1330, "y": 690, "anchor": [1000, 590], "text": "Air pushed down", "sub": "the wing is pushed up", "bar": "red", "z": 9, "in": {"fx": "fade", "at": "c2+0.8"}}, {"id": "fL2", "type": "arrow", "from": [820, 420], "to": [820, 170], "color": "accent", "width": 14, "z": 7, "in": {"fx": "draw", "at": "c4", "dur": 0.7}}, {"id": "tL2", "type": "tag", "text": "LIFT", "x": 940, "y": 190, "fill": "accent", "size": 40, "z": 8, "rotate": 0, "in": {"fx": "stamp", "at": "c4+0.3"}}]}, {"id": "speed", "title": "Lift needs speed", "cues": [{"say": "Lift grows with the square of speed.", "tr": {"zh": "升力与速度的平方成正比。"}, "caption": "Lift grows with the square of speed (lift ∝ v²).", "audio": "../voice/speed-1.mp3"}, {"say": "Double the speed, and you get four times the lift.", "tr": {"zh": "速度翻一倍，升力变成四倍。"}, "caption": "Double the speed → 4× the lift.", "audio": "../voice/speed-2.mp3"}, {"say": "That's why a plane needs a long runway to build up speed.", "tr": {"zh": "所以飞机需要一条长跑道来加速。"}, "audio": "../voice/speed-3.mp3"}], "elements": [{"id": "chartDraw", "type": "chart", "x": 1030, "y": 480, "w": 760, "h": 440, "title": "Lift vs speed", "bar": "blue", "z": 6, "smooth": true, "shadow": 0, "series": [{"points": [[0.0, 0.0], [0.1, 0.01], [0.2, 0.038], [0.3, 0.085], [0.4, 0.152], [0.5, 0.237], [0.6, 0.342], [0.7, 0.465], [0.8, 0.608], [0.9, 0.769], [1.0, 0.95]], "color": "accent2", "width": 6}, {"points": [[0, 0.62], [1, 0.62]], "color": "red", "width": 4}], "note": "teal = lift   ·   red = weight   ·   speed →", "in": {"fx": "draw", "at": "c1+0.3", "dur": 2.4}}, {"id": "t2x", "type": "tag", "text": "2× speed", "x": 300, "y": 440, "fill": "blue", "size": 40, "z": 8, "rotate": -3, "in": {"fx": "stamp", "at": "c2+0.2"}, "color": "#ffffff"}, {"id": "t4x", "type": "tag", "text": "= 4× lift", "x": 330, "y": 540, "fill": "accent", "size": 46, "z": 8, "rotate": 2, "in": {"fx": "stamp", "at": "c2+0.9"}}, {"id": "rwIcon", "type": "tag", "text": "runway ≈ 2–3 km", "x": 320, "y": 660, "fill": "card", "size": 28, "z": 8, "in": {"fx": "rise", "at": "c3+0.3"}}]}, {"id": "climb", "title": "Rotate, lift off, climb", "tail": 2.4, "cues": [{"say": "At about two hundred and seventy kilometers per hour, lift becomes bigger than weight.", "tr": {"zh": "速度达到约每小时 270 公里时，升力超过了重力。"}, "caption": "At about 270 km/h, lift becomes bigger than weight.", "audio": "../voice/climb-1.mp3"}, {"say": "The pilot pulls back, and the nose tilts up.", "tr": {"zh": "飞行员向后拉杆，机头抬起。"}, "audio": "../voice/climb-2.mp3"}, {"say": "The wheels leave the runway, and the plane climbs away.", "tr": {"zh": "轮子离开跑道，飞机爬升远去。"}, "audio": "../voice/climb-3.mp3"}], "elements": [{"id": "rw2", "type": "rect", "x": 800, "y": 712, "w": 1800, "h": 70, "fill": "#5d6366", "shadow": 0.4, "until": "climb", "z": 1, "in": {"fx": "unfold", "at": 0.05, "dur": 0.8}}, {"id": "rw2-dash", "type": "flow", "points": [[1750, 712], [-150, 712]], "smooth": false, "glyph": "dash", "size": 26, "color": "#f4efe6", "spacing": 150, "speed": 0, "alpha": 0.9, "until": "climb", "z": 2, "in": {"fx": "fade", "at": 0.45}, "keys": [{"at": 0.1, "dur": 0.01, "speed": 900}]}, {"id": "plane2", "type": "group", "x": 600, "y": 586, "scale": 1.35, "z": 5, "in": {"fx": "fade", "at": 0.15, "dur": 0.9}, "children": [{"type": "curve", "from": [-20, 22], "to": [-20, 50], "color": "ink", "width": 5, "out": {"fx": "fade", "at": "climb:c3+0.9", "dur": 0.5}}, {"type": "circle", "x": -20, "y": 58, "r": 10, "fill": "ink", "shadow": 0, "out": {"fx": "fade", "at": "climb:c3+0.9", "dur": 0.5}}, {"type": "curve", "from": [180, 22], "to": [180, 48], "color": "ink", "width": 4, "out": {"fx": "fade", "at": "climb:c3+0.9", "dur": 0.5}}, {"type": "circle", "x": 180, "y": 56, "r": 9, "fill": "ink", "shadow": 0, "out": {"fx": "fade", "at": "climb:c3+0.9", "dur": 0.5}}, {"type": "poly", "points": [[-245, -10], [-212, -122], [-182, -122], [-160, -26]], "fill": "red"}, {"type": "poly", "smooth": true, "points": [[-262, -6], [-205, -30], [180, -34], [236, -24], [264, -2], [250, 16], [200, 25], [-200, 25], [-252, 10]], "fill": "card"}, {"type": "poly", "points": [[-236, -2], [-296, -18], [-280, -26], [-205, -14]], "fill": "red", "shadow": 0.4}, {"type": "poly", "points": [[208, -22], [234, -18], [243, -7], [214, -9]], "fill": "blue", "shadow": 0}, {"type": "seq", "from": [-170, -9], "to": [160, -9], "pattern": "ooooooooooooooo", "size": 8, "colo